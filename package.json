    "@aws-sdk/client-secrets-manager": "^3",
    "@aws-sdk/lib-dynamodb": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@embedpdf/fonts-arabic": "^1.0.0",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "aws-jwt-verify": "^5.2.1",
    "lodash": "^4",
    "nodemailer": "^7.0.5",
    "openai": "^7.8.0",
    "pdfkit": "^0.15.0",
    "sharp": "^0.34.5",
    "uuid": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
